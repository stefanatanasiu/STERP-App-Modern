@using Sterp.Web.Framework.Format
@* UiStyle.Caption + UiStyle.Edit (UiStyle.vb): the caption at (CaptionX, Y + 3) and a 20-pixel text box at (X, Y) of the
   legacy form. The <label> holds the caption without its trailing colon (the colon follows it), so the caption text alone
   names the field; the accessible name is the caption without "&" and ":" (contracts 9.6, DEVELOPER-GUIDE 10.3). *@
<span style="@($"position:absolute;left:{CaptionX}px;top:{Y + 3}px;width:{CaptionWidth}px;height:15px;white-space:nowrap;overflow:hidden")"><label for="@Id"><StMnemonic Text="@Name" /></label>@Colon</span>
<input id="@Id" class="st-input" aria-label="@UkFormat.LabelText(Caption)" data-sterp-field="@Field" value="@Value" readonly="@ReadOnly"
       style="@($"position:absolute;left:{X}px;top:{Y}px;width:{Math.Max(Width - 8, 4)}px")" autocomplete="off" spellcheck="false" @oninput="OnInput" />

@code {
    [Parameter, EditorRequired] public string Caption { get; set; } = "";

    [Parameter] public int CaptionX { get; set; }

    [Parameter] public int CaptionWidth { get; set; } = 90;

    [Parameter] public int X { get; set; }

    [Parameter] public int Y { get; set; }

    /// <summary>Legacy control width including the 3D border.</summary>
    [Parameter] public int Width { get; set; } = 120;

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>Legacy field key reported with key presses (the F2 lookup of the focused field).</summary>
    [Parameter] public string? Field { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    private string Name => Caption.EndsWith(':') ? Caption[..^1] : Caption;

    private string Colon => Caption.EndsWith(':') ? ":" : "";

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }
}
