@using Sterp.Web.Framework.Format
@* A captioned tick box (UiStyle.Tick). *@
<span class="@(Inline ? "st-filter" : "st-field")" data-sterp-field="@Field">
    <label for="@Id" style="@(LabelWidth > 0 ? $"width:{LabelWidth}px;display:inline-block" : null)"><StMnemonic Text="@Caption" /></label>
    <input type="checkbox" id="@Id" aria-label="@UkFormat.LabelText(Caption)" checked="@Value" disabled="@Disabled" @onchange="OnChange" />
</span>

@code {
    [Parameter, EditorRequired] public string Caption { get; set; } = "";

    [Parameter] public bool Value { get; set; }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter] public string Id { get; set; } = "c-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public string? Field { get; set; }

    [Parameter] public int LabelWidth { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Inline { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        Value = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await ValueChanged.InvokeAsync(Value);
    }
}
