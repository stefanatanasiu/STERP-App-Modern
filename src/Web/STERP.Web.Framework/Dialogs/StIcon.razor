@* Message box icons (MessageBoxIcon): decorative, the dialog title carries the meaning as text. *@
@switch (Kind)
{
    case DialogIcon.Information:
        <svg class="st-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="#fff" stroke="#000080" stroke-width="2" /><rect x="14" y="13" width="4" height="11" fill="#000080" /><rect x="14" y="7" width="4" height="4" fill="#000080" /></svg>
        break;
    case DialogIcon.Question:
        <svg class="st-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="#fff" stroke="#000080" stroke-width="2" /><text x="16" y="23" font-size="18" font-weight="bold" text-anchor="middle" fill="#000080">?</text></svg>
        break;
    case DialogIcon.Warning:
        <svg class="st-icon" viewBox="0 0 32 32" aria-hidden="true"><polygon points="16,2 31,29 1,29" fill="#ffff00" stroke="#000" stroke-width="1.5" /><rect x="14.5" y="10" width="3" height="11" /><rect x="14.5" y="23" width="3" height="3" /></svg>
        break;
    case DialogIcon.Error:
        <svg class="st-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="#e00000" stroke="#600" stroke-width="1.5" /><path d="M10 10 L22 22 M22 10 L10 22" stroke="#fff" stroke-width="3.5" /></svg>
        break;
}

@code {
    [Parameter] public DialogIcon Kind { get; set; }
}
