<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>Sterp.Web.Client</RootNamespace>
    <AssemblyName>STERP.Web.Client</AssemblyName>
    <Description>STERP-WEB shell (Interactive WebAssembly): start-up, sign-on, menu bar, toolbar, status bar, MDI-like workspace and the page registry composed from the slice page libraries.</Description>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
