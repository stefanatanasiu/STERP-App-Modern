      "scenarios": [
        {
          "id": "FR-STERP-PORTAL-001-AC1",
          "ac": 1,
          "title": "Opening the portal catalogue opens no database session from STERP.ApiPortal",
          "layer": "contract",
          "runner": "gui",
          "dataset": "fresh",
          "context": {
            "login": "SYSADM",
            "company": "STC",
            "site": "RDG",
            "businessDate": "2026-10-07"
          },
          "steps": [
            {
              "save": "cat",
              "gui": "/",
              "actions": []
            }
          ],
          "assertions": [
            {
              "on": "cat",
              "text": "STERP-PLATFORM"
            },
            {
              "sql": "SELECT COUNT(*) FROM sys.dm_exec_sessions WHERE program_name LIKE 'STERP.ApiPortal%'",
              "equals": 0
            }
          ],
          "derivation": "AC 'no SQL client reference in STERP.ApiPortal' and STERP-PORTAL.md FR-STERP-PORTAL-001 (documents only, never connects to the database); the portal catalogue is https://localhost:7103/ (portal host, no STERP-WEB route applies, hence route '/'); the assembly-reference check is a build check outside the DSL, so the scenario pins its runtime consequence (no session with an STERP.ApiPortal application name, contracts 5.6 naming).",
          "confidence": "inferred"
        }
      ]
