      "scenarios": [
        {
          "id": "FR-STERP-PORTAL-010-AC1",
          "ac": 1,
          "title": "API Console shows so_acceptSalesOrder with its x-sterp-legacy chain, FR ids, permission and unit-of-work text",
          "layer": "ui-journey",
          "runner": "gui",
          "dataset": "fresh",
          "context": {
            "login": "SYSADM",
            "company": "STC",
            "site": "RDG",
            "businessDate": "2026-10-07"
          },
          "covers": [
            "navigation"
          ],
          "steps": [
            {
              "save": "op",
              "gui": "/",
              "actions": [
