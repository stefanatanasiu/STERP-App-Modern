          },
          "steps": [
            {
              "save": "own",
              "gui": "/",
              "actions": [
                {
                  "select": {
                    "label": "Select a definition",
                    "value": "STERP-PLATFORM"
                  }
                },
                {
                  "click": "platform_getSession"
                },
