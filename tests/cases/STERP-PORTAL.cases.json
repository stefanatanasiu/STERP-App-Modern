                    "value": "STERP-SO"
                  }
                },
                {
                  "click": "so_acceptSalesOrder"
                }
              ]
            }
          ],
          "assertions": [
            {
              "on": "op",
              "text": "x-sterp-legacy"
            },
            {
              "on": "op",
              "text": "SOACCEPT ACCEPT"
            },
            {
              "on": "op",
              "text": "x-sterp-requirements"
            },
            {
              "on": "op",
              "text": "FR-STERP-SO-017"
            },
