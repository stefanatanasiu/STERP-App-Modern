    {
      "requirement_id": "FR-STERP-PORTAL-012",
      "scenarios": [
        {
          "id": "FR-STERP-PORTAL-012-AC1",
          "ac": 1,
          "title": "Portal shows Windows curl and PowerShell commands for an executed GET whose direct call returns the same body",
          "layer": "ui-journey",
          "runner": "gui",
          "dataset": "fresh",
          "context": {
            "login": "SYSADM",
            "company": "STC",
            "site": "RDG",
            "businessDate": "2026-10-07"
          },
          "steps": [
            {
              "save": "cmd",
              "gui": "/",
              "actions": [
                {
                  "select": {
                    "label": "Select a definition",
                    "value": "STERP-PLATFORM"
                  }
                },
                {
                  "click": "platform_getSession"
                },
                {
                  "click": "Try it out"
                },
                {
                  "click": "Execute"
                }
              ]
            },
            {
              "save": "direct",
              "call": "platform_getSession"
            }
          ],
          "assertions": [
            {
              "on": "cmd",
              "text": "curl.exe --negotiate -u :"
            },
            {
              "on": "cmd",
              "text": "-UseDefaultCredentials"
            },
            {
              "on": "cmd",
              "text": "X-STERP-Company"
            },
            {
              "on": "direct",
              "status": 200
            },
            {
              "on": "direct",
              "json": "$.user.userCode",
              "equals": "SYSADM"
            },
            {
              "on": "direct",
              "json": "$.selected.companyCode",
              "equals": "STC"
            }
          ],
          "derivation": "AC 'pasted Windows curl command returns same body as Try it out' with STERP-PORTAL.md FR-STERP-PORTAL-012 (curl --negotiate -u :, curl.exe, Invoke-RestMethod -UseDefaultCredentials with context headers); executing a pasted command line is outside the DSL, so the same GET is issued directly and its body pinned to the values Try it out shows; page = API Console https://localhost:7103/ (route '/').",
          "confidence": "unknown"
        }
      ]
    },
