              "on": "op",
              "text": "SO.ORDER.ENTER"
            },
            {
              "on": "op",
              "text": "x-sterp-uow"
            },
            {
              "on": "op",
              "text": "Three separate commits"
            }
          ],
          "derivation": "AC 'so accept operation shows x-sterp-legacy, requirements, permissions, uow' with the binding STERP-SO.openapi.yaml values of so_acceptSalesOrder (x-sterp-requirements FR-STERP-SO-017/020, x-sterp-permission SO.ORDER.ENTER, x-sterp-legacy 'SOACCEPT ACCEPT', x-sterp-uow 'Three separate commits...'); page = portal API Console https://localhost:7103/ (route '/', document selector STERP-SO).",
          "confidence": "inferred"
        }
