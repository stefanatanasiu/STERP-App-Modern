    {
      "requirement_id": "FR-STERP-API-001",
      "scenarios": [
        {
          "id": "FR-STERP-API-001-AC1",
          "ac": 1,
          "title": "Online host readiness runs the drift check against the isolated database and reports no difference",
          "layer": "contract",
          "runner": "api",
          "dataset": "fresh",
          "context": {
            "login": "SYSADM",
            "company": "STC",
            "site": "RDG"
          },
          "covers": [
            "health"
          ],
          "steps": [
            {
              "save": "r",
              "call": "api_getReadiness"
            }
          ],
          "assertions": [
            {
              "on": "r",
              "status": 200
            },
            {
              "on": "r",
              "json": "$.status",
              "equals": "Healthy"
            },
            {
              "on": "r",
              "json": "$.checks[*].name",
              "equals": "schema-drift"
            },
            {
              "on": "r",
              "json": "$.driftDifferences",
              "count": 0
            },
            {
              "on": "r",
              "json": "$.deliveredSlices[*]",
              "equals": "PLATFORM"
            }
          ],
          "derivation": "AC 'removed column in isolated DB makes /health/ready Unhealthy; SQL trace shows no DDL' with the api_getReadiness 200 example and contracts 6.11 (db/00-create-database.sql:5-12); removing a column needs DDL, which the DSL forbids, and the SQL trace is outside the DSL, so only the unmodified-schema half (Healthy, no differences) is pinned and the Unhealthy half is unknown.",
          "confidence": "unknown"
        }
      ]
    },
