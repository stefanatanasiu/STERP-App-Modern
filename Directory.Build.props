<Project>
  <!--
    STERP modernized application (Agent 08). Binding stack per Agent 06 contracts section 2:
    .NET 10 LTS (net10.0), C# 14, nullable enabled, nullable warnings as errors.
    tests/ (Agent 07) has its own Directory.Build.props and is not affected by this file.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1603;NU1608</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>STERP</Company>
    <Product>STERP - Supply Chain Management (modernized)</Product>
    <Authors>Stefan Atanasiu</Authors>
    <Copyright>Copyright (c) 2026 Stefan Atanasiu</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <SterpAgent06Attempt>a06-20261020T112437Z-034eff00</SterpAgent06Attempt>
    <SterpAgent08Attempt>a08-20261020T204651Z-aa6a44e4</SterpAgent08Attempt>
    <InformationalVersion>1.0.0+$(SterpAgent08Attempt)</InformationalVersion>
  </PropertyGroup>
</Project>
